JWT_REFRESH_TTL=168h
COOKIE_SECURE=false

RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=
RUSTFS_ENDPOINT=

REPORT_TZ=Asia/Jakarta
COMPANY_NAME=Aegis
